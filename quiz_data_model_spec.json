  "schema_version": "1.0.0",
  "generated_at": "2026-05-20T00:00:00+05:00",
  "purpose": "Data model for a gamified multiple-choice quiz pack similar to Kahoot, grounded in LMS programming tasks.",
  "root_object": {
    "type": "object",
    "required": [
      "meta",
      "items"
    ],
    "fields": {
      "meta": "Object with generation metadata, source files, counts, coverage, type/topic distributions and validation summary.",
      "items": "Array of quiz item objects. In this pack it contains exactly 20000 items: 5000 per domain."
    }
  },
  "item_model": {
    "type": "object",
    "required": [
      "id",
      "domain",
      "topic",
      "tier",
      "difficulty",
      "type",
      "format",
      "source_task_id",
      "question",
      "options",
      "answer",
      "answer_index",
      "explanation",
      "tags",
      "platform",
      "source"
    ],
    "fields": {
      "id": {
        "type": "string",
        "description": "Stable quiz item id. Format: quiz_<domain>_<5-digit-number>."
      },
      "domain": {
        "type": "string",
        "enum": [
          "python",
          "javascript",
          "frontend",
          "scratch"
        ],
        "description": "Learning domain/category from the platform."
      },
      "domain_label": {
        "type": "string",
        "description": "Human-readable domain name."
      },
      "topic": {
        "type": "string",
        "description": "Topic tag inherited from the source task, for example strings, arrays, layout, variables."
      },
      "topic_label": {
        "type": "string",
        "description": "Russian human-readable topic label."
      },
      "tier": {
        "type": "string",
        "enum": [
          "D",
          "C",
          "B",
          "A",
          "S"
        ],
        "description": "Difficulty tier from the source task."
      },
      "difficulty": {
        "type": "integer",
        "minimum": 1,
        "maximum": 5,
        "description": "Numeric difficulty derived from tier: D=1, C=2, B=3, A=4, S=5."
      },
      "type": {
        "type": "string",
        "description": "Question generator/type. See question_type_catalog."
      },
      "format": {
        "type": "string",
        "enum": [
          "multiple_choice"
        ],
        "description": "Current pack uses single-answer multiple choice only."
      },
      "source_task_id": {
        "type": "string",
        "description": "ID of the original LMS task used to generate the quiz item."
      },
      "source_task_title": {
        "type": "string",
        "description": "Title of the original task, copied/truncated for context."
      },
      "question": {
        "type": "string",
        "description": "Question text shown to the learner."
      },
      "code": {
        "type": [
          "string",
          "null"
        ],
        "description": "Optional code, HTML/CSS, test call, or Scratch pseudo-script displayed with the question."
      },
      "cloze": {
        "type": [
          "object",
          "null"
        ],
        "description": "Present when type is code_cloze_mc or scratch_cloze_mc.",
        "fields": {
          "blank_id": "Identifier of the blank, usually blank_1.",
          "template": "Code/pseudo-code with ____ marking the missing fragment.",
          "answer": "Text that fills the blank.",
          "blank_kind": "Kind of hidden unit: keyword, function_name, css_property, css_value, html_tag, scratch_block, etc."
        }
      },
      "options": {
        "type": "array",
        "minItems": 4,
        "maxItems": 4,
        "description": "Exactly four answer options.",
        "items": {
          "type": "object",
          "required": [
            "id",
            "text"
          ],
          "fields": {
            "id": "A/B/C/D option id.",
            "text": "Visible option text."
          }
        }
      },
      "answer": {
        "type": "object",
        "required": [
          "id",
          "text"
        ],
        "description": "The correct option object duplicated for fast checking."
      },
      "answer_index": {
        "type": "integer",
        "minimum": 0,
        "maximum": 3,
        "description": "Zero-based index of the correct option in options."
      },
      "explanation": {
        "type": "string",
        "description": "Short feedback shown after answering."
      },
      "tags": {
        "type": "array",
        "items": "string",
        "description": "Search/filter tags. Includes domain, topic and question type."
      },
      "platform": {
        "type": "object",
        "description": "Kahoot-like presentation settings.",
        "fields": {
          "mode": "Always kahoot_like.",
          "time_limit_sec": "Recommended timer for the item.",
          "points": "Base points. Harder tiers receive more points.",
          "streak_bonus": "Whether streaks can multiply score.",
          "single_correct": "True; exactly one correct option.",
          "review_after_answer": "True; explanation can be shown after answer."
        }
      },
      "source": {
        "type": "object",
        "description": "Traceability metadata back to the source LMS task and generator.",
        "fields": {
          "task_id": "Original task id.",
          "task_title": "Original task title.",
          "task_topic": "Original topic.",
          "task_tier": "Original tier.",
          "engine": "Source check engine, e.g. pyodide/javascript/iframe/manual.",
          "source_pack": "Source pack marker from original task/meta.",
          "generated_from_candidate_hash": "Hash of the generated candidate before final sequential id."
        }
      }
    }
  },
  "question_type_catalog": {
    "test_case_output_mc": "Learner predicts expected output/return value of a source test call.",
    "variable_value_mc": "Learner selects the required final value of a checked variable.",
    "variable_name_mc": "Learner identifies the variable name that the task/check expects.",
    "function_name_mc": "Learner identifies the function name that must not be changed for autograding.",
    "code_cloze_mc": "Learner fills one blank in Python/JS/HTML/CSS source code.",
    "css_rule_mc": "Learner selects the required CSS property:value rule for a selector.",
    "selector_exists_mc": "Learner identifies a selector that must exist in the frontend solution.",
    "content_expectation_mc": "Learner identifies text/regex/content expected by a frontend check.",
    "scratch_block_mc": "Learner selects a Scratch block or block category needed for a project.",
    "scratch_cloze_mc": "Learner fills a blank in a Scratch-style pseudo-script.",
    "manual_rubric_mc": "Learner identifies what matters in manual Scratch review.",
    "syntax_flashcard_mc": "Domain syntax mini-question tied to the task topic.",
    "task_goal_mc": "Learner identifies the practical goal of the original task.",
    "topic_identification_mc": "Learner identifies the platform topic of the task.",
    "task_title_match_mc": "Learner matches task description to the original task title."
  },
  "generation_constraints": {
    "domains": [
      "python",
      "javascript",
      "frontend",
      "scratch"
    ],
    "items_per_domain": 5000,
    "total_items": 20000,
    "language": "ru",
    "options_per_item": 4,
    "correct_answers_per_item": 1,
    "source_coverage_rule": "Every original source task in Python, JavaScript, Frontend and Scratch appears in at least one quiz item.",
    "cloze_marker": "____",
    "id_pattern": "^quiz_(python|javascript|frontend|scratch)_\\d{5}$"
  },
